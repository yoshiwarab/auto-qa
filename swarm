#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_BRANCH="${SWARMFORGE_SCRIPTS_BRANCH:-herdr-runtime}"
LOCAL_SOURCE="${SWARMFORGE_SOURCE_DIR:-${SWARMFORGE_SCRIPTS_SOURCE:-"$PROJECT_ROOT/../swarm-forge"}}"
ARCHIVE_URL="${SWARMFORGE_SCRIPTS_URL:-https://github.com/yoshiwarab/swarm-forge/archive/refs/heads/${MAIN_BRANCH}.tar.gz}"
TEMP_DIR=""

cleanup() {
  if [[ -n "$TEMP_DIR" ]]; then
    rm -rf "$TEMP_DIR"
  fi
}
trap cleanup EXIT

install_from_directory() {
  local source_root="$1"

  mkdir -p "$PROJECT_ROOT/swarmforge"
  if [[ ! -d "$PROJECT_ROOT/swarmforge/scripts" ]]; then
    cp -R "$source_root/swarmforge/scripts" "$PROJECT_ROOT/swarmforge/scripts"
  fi
  if [[ ! -d "$PROJECT_ROOT/swarmforge/scripts/shared-articles" ]]; then
    mkdir -p "$PROJECT_ROOT/swarmforge/scripts/shared-articles"
    cp -R \
      "$source_root/swarmforge/constitution/articles/." \
      "$PROJECT_ROOT/swarmforge/scripts/shared-articles/"
  fi
}

if [[ ! -d "$PROJECT_ROOT/swarmforge/scripts" || ! -d "$PROJECT_ROOT/swarmforge/scripts/shared-articles" ]]; then
  if [[ -d "$LOCAL_SOURCE/swarmforge/scripts" ]]; then
    install_from_directory "$LOCAL_SOURCE"
  else
    TEMP_DIR="$(mktemp -d)"
    if ! curl -fL "$ARCHIVE_URL" | tar -xz --strip-components=1 -C "$TEMP_DIR"; then
      cat >&2 <<EOF
Unable to install the SwarmForge runtime from $ARCHIVE_URL.
Install the local fork at $LOCAL_SOURCE, set SWARMFORGE_SCRIPTS_URL to a published runtime archive, or set SWARMFORGE_SOURCE_DIR to an existing fork checkout.
EOF
      exit 1
    fi
    install_from_directory "$TEMP_DIR"
  fi
fi

exec "$PROJECT_ROOT/swarmforge/scripts/swarmforge.sh" "$@"

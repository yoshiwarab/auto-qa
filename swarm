#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_BRANCH="${SWARMFORGE_SCRIPTS_BRANCH:-herdr-runtime}"
LOCAL_SOURCE="${SWARMFORGE_SCRIPTS_SOURCE:-/home/dev/src/swarm-forge}"
ARCHIVE_URL="${SWARMFORGE_SCRIPTS_URL:-https://github.com/yoshiwarab/swarm-forge/archive/refs/heads/${MAIN_BRANCH}.tar.gz}"
TEMP_DIR=""

cleanup() {
  if [[ -n "$TEMP_DIR" ]]; then
    rm -rf "$TEMP_DIR"
  fi
}
trap cleanup EXIT

if [[ ! -d "$SCRIPT_DIR/swarmforge/scripts" || ! -d "$SCRIPT_DIR/swarmforge/scripts/shared-articles" ]]; then
  TEMP_DIR="$(mktemp -d)"
  mkdir -p "$SCRIPT_DIR/swarmforge"
  if [[ -d "$LOCAL_SOURCE/swarmforge/scripts" ]]; then
    cp -R "$LOCAL_SOURCE/swarmforge" "$TEMP_DIR/swarmforge"
  else
    curl -L "$ARCHIVE_URL" | tar -xz --strip-components=1 -C "$TEMP_DIR"
  fi
  if [[ ! -d "$SCRIPT_DIR/swarmforge/scripts" ]]; then
    cp -R "$TEMP_DIR/swarmforge/scripts" "$SCRIPT_DIR/swarmforge/scripts"
  fi
  if [[ -d "$TEMP_DIR/swarmforge/constitution/articles" ]]; then
    mkdir -p "$SCRIPT_DIR/swarmforge/scripts/shared-articles"
    cp -R "$TEMP_DIR/swarmforge/constitution/articles/." "$SCRIPT_DIR/swarmforge/scripts/shared-articles/"
  fi
fi

exec "$SCRIPT_DIR/swarmforge/scripts/swarmforge.sh" "$@"


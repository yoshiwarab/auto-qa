{
  "name": "auto-qa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "acceptance": "bash scripts/acceptance.sh",
    "acceptance:setup": "bash scripts/setup-acceptance-tools.sh",
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json",
    "swarm:start": "bash scripts/swarmforge-project.sh start",
    "swarm:start:ghostty": "bash scripts/swarmforge-project.sh start ghostty",
    "swarm:start:terminal": "bash scripts/swarmforge-project.sh start current",
    "swarm:status": "bash scripts/swarmforge-project.sh status",
    "swarm:attach": "bash scripts/swarmforge-project.sh attach integrated",
    "swarm:attach:specifier": "bash scripts/swarmforge-project.sh attach specifier",
    "swarm:attach:coder": "bash scripts/swarmforge-project.sh attach coder",
    "swarm:attach:refactorer": "bash scripts/swarmforge-project.sh attach refactorer",
    "swarm:attach:architect": "bash scripts/swarmforge-project.sh attach architect",
    "swarm:stop": "bash scripts/swarmforge-project.sh stop"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}

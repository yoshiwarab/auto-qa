{
  "name": "auto-qa",
  "version": "0.0.0",
  "private": true,
  "repository": "github:yoshiwarab/auto-qa",
  "type": "module",
  "files": [
    "dist/src",
    "skills"
  ],
  "bin": {
    "auto-qa": "dist/src/cli.js"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "budget": "lines=$(cat src/*.ts | wc -l); [ $lines -le 450 ] || { echo \"src/ has $lines lines; the budget is 450\" >&2; exit 1; }",
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm budget && pnpm lint && pnpm build && pnpm typecheck && vitest run",
    "lint": "eslint .",
    "prepare": "tsc --project tsconfig.build.json",
    "setup": "husky",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@playwright/test": "1.64.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}

{
  "name": "auto-qa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/src",
    "skills"
  ],
  "bin": {
    "auto-qa": "dist/src/cli.js"
  },
  "exports": {
    "./test": {
      "types": "./dist/src/test.d.ts",
      "default": "./dist/src/test.js"
    }
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm lint && pnpm build && pnpm typecheck && vitest run",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}

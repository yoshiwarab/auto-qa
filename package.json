{
  "name": "auto-qa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "auto-qa": "dist/src/cli.js"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "acceptance": "bash scripts/acceptance.sh",
    "acceptance:mutation": "bash scripts/acceptance-mutation.sh",
    "acceptance:setup": "bash scripts/setup-acceptance-tools.sh",
    "analyze:duplication": "jscpd src acceptance test --min-lines 5 --min-tokens 50 --reporters console --ignore '**/build/**,**/dist/**,**/node_modules/**,**/tmp/**' --no-colors --no-tips",
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "mutation:workflow-machine": "stryker run --mutate src/workflowMachine.ts --testFiles test/workflow-machine.test.ts --testRunner vitest --plugins @stryker-mutator/vitest-runner --concurrency 2 --reporters clear-text,progress --ignoreStatic --incremental --incrementalFile reports/stryker-workflow-machine.json --cleanTempDir always",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --project tsconfig.json",
    "swarm:start": "bash scripts/swarmforge-project.sh start",
    "swarm:start:ghostty": "bash scripts/swarmforge-project.sh start ghostty",
    "swarm:start:terminal": "bash scripts/swarmforge-project.sh start current",
    "swarm:status": "bash scripts/swarmforge-project.sh status",
    "swarm:attach": "bash scripts/swarmforge-project.sh attach integrated",
    "swarm:attach:specifier": "bash scripts/swarmforge-project.sh attach specifier",
    "swarm:attach:coder": "bash scripts/swarmforge-project.sh attach coder",
    "swarm:attach:refactorer": "bash scripts/swarmforge-project.sh attach refactorer",
    "swarm:attach:architect": "bash scripts/swarmforge-project.sh attach architect",
    "swarm:stop": "bash scripts/swarmforge-project.sh stop"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "jscpd": "^5.0.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
